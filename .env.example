# DeepCode Enhanced - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# Application Settings
# ============================================================================
DEEPCODE_MODE=web
DEEPCODE_HOST=localhost
DEEPCODE_PORT=8503
DEEPCODE_LOG_LEVEL=INFO
DEEPCODE_THEME=dark

# ============================================================================
# AI Provider API Keys
# ============================================================================
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096

# ============================================================================
# Performance & Caching
# ============================================================================
DEEPCODE_CACHE=true
DEEPCODE_CACHE_DIR=.deepcode_cache
DEEPCODE_MAX_WORKERS=4
DEEPCODE_TIMEOUT=300

# Redis Configuration (optional, for advanced caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Document Processing
# ============================================================================
DOCUMENT_SEGMENTATION_ENABLED=true
DOCUMENT_SEGMENTATION_THRESHOLD=50000
MAX_DOCUMENT_SIZE_MB=50

# ============================================================================
# MCP Agent Configuration
# ============================================================================
MCP_CONFIG_PATH=mcp_agent.config.yaml
MCP_SECRETS_PATH=mcp_agent.secrets.yaml

# ============================================================================
# Output & Workspace
# ============================================================================
DEEPCODE_WORKSPACE=deepcode_lab
OUTPUT_DIR=output
LOGS_DIR=logs

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_BATCH_PROCESSING=false
ENABLE_ASYNC_PROCESSING=true
ENABLE_TELEMETRY=false
ENABLE_CODE_VALIDATION=true

# ============================================================================
# Security
# ============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8503

# ============================================================================
# Development Settings (only for dev environment)
# ============================================================================
DEBUG=false
DEV_MODE=false
RELOAD=false
